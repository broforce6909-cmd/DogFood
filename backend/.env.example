# Copy this file to `.env` (same directory) to override the defaults in
# app/config.py without editing docker-compose.yml or exporting environment
# variables by hand. Every value below already has a working default that
# lets `docker compose up` run with no `.env` file at all -- that default is
# what a laptop needs and exactly what a real deployment must not keep.
#
# ENVIRONMENT=production is the one setting that turns on enforcement: at
# startup, Settings.model_post_init refuses to run production with any of the
# dev-default secrets below still in place, an insecure session cookie, or a
# wildcard CORS origin. See app/config.py. Nothing below is optional once
# ENVIRONMENT=production; the app will not start rather than serve real data
# on a public secret.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

# "development" (default) or "production". Only "production" enforces the
# checks above -- staging/demo installs that still want the safety net should
# also set this to "production".
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql+psycopg://dogfood:dogfood@localhost:5432/dogfood

# ---------------------------------------------------------------------------
# Secrets -- CHANGE THESE BEFORE ENVIRONMENT=production
# ---------------------------------------------------------------------------

# Signs the session cookie. The committed default is public (it is right here,
# in git); rotating it invalidates every live session. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-secret-change-me-in-production

# Ed25519 PKCS8 PEM. Asymmetric on purpose -- a verifier only ever needs the
# *public* half (published at GET /api/signing/public-keys), never this one.
# Generate a real keypair with:
#   openssl genpkey -algorithm ed25519 -out signing_key.pem
SIGNING_ACTIVE_KID=dev-2026-01
SIGNING_ACTIVE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# JSON array of {"kid": "...", "public_key_pem": "..."} for retired signing
# keys -- public half only, kept so certificates signed under an old key still
# verify after rotation. Empty until a rotation has actually happened.
SIGNING_RETIRED_KEYS=[]

# ---------------------------------------------------------------------------
# Network and cookies
# ---------------------------------------------------------------------------

# Comma-separated. Never "*" in production -- browsers reject it anyway
# alongside allow_credentials=True, and Settings refuses to start on it.
CORS_ORIGINS=http://localhost:3000

# Where the browser-facing portal lives. Only used to build clickable links
# (team invites, emailed account links, and the QR code and printed verify URL
# on every certificate) -- never trusted for access control.
#
# The localhost default is right for a laptop demo and WRONG for a real
# deployment: certificates would carry a QR code that points at the reader's own
# machine, and nothing errors to tell you. Set it to the public https:// origin
# before issuing or distributing anything. See OPERATIONS.md, "The public URL".
WEB_BASE_URL=http://localhost:3000

# A real deployment behind TLS must set this to true, or the session cookie's
# Secure flag never gets set and Settings refuses to start in production.
# Left false here because a Secure cookie over plain http:// (this stack's own
# local default) silently never arrives.
SESSION_COOKIE_SECURE=false

SESSION_COOKIE_NAME=dogfood_session
SESSION_TTL_HOURS=72

# ---------------------------------------------------------------------------
# Data retention
# ---------------------------------------------------------------------------

# Days before a voter row's ip_address/user_agent are scrubbed. See
# app/routers/voting.py's _anonymize_stale_voters.
VOTER_IP_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Outbound email (registration confirmation, results-published notification)
# ---------------------------------------------------------------------------

# Unset (the default): nothing is actually sent. Every email this system
# would have sent is logged in full to the api container's own logs instead
# -- see app/email.py. This is the normal state for a laptop install and for
# the acceptance suite, not a "disabled" flag to look for elsewhere.
#
# Point this at MailHog (or any other SMTP-speaking capture tool) for local
# testing that actually wants to see rendered emails in an inbox-like UI:
#   docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_USE_TLS=false
# then open http://localhost:8025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM="Dogfood Hackathon <noreply@dogfood.example>"

# ---------------------------------------------------------------------------
# Fixtures
# ---------------------------------------------------------------------------

# Seeds demo data on an empty database at startup. Leave true for a judge
# install; a real event's database should not auto-seed.
SEED_ON_START=true
